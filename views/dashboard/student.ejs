<%- include('../layouts/header'); %>
<h2><i class="bi bi-house-door"></i> Dasbor Siswa</h2>
<p class="text-muted">Selamat datang, <%= user.name %>. Jelajahi katalog kelas di bawah ini.</p>

<div class="row">
  <div class="col-md-12">
    <div class="card shadow mb-4">
      <div class="card-header"><h5>Katalog Kelas Tersedia</h5></div>
      <div class="card-body">
        <% if (courses && courses.length > 0) { %>
          <div class="row row-cols-1 row-cols-md-3 g-4">
            <% courses.forEach((course) => { %>
              <div class="col">
                <div class="card h-100 shadow-sm">
                  <div class="card-body">
                    <h5 class="card-title"><%= course.title %></h5>
                    <p class="card-text text-muted"><%= course.description || '-' %></p>
                    <p class="small text-muted">Pengajar: <%= course.teacher_name %></p>
                  </div>
                  <div class="card-footer bg-transparent border-top">
                    <a href="/courses/<%= course.id %>" class="btn btn-sm btn-outline-primary w-100">Lihat Detail</a>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted">Belum ada kelas tersedia.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../layouts/footer'); %>
